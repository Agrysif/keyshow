{
  "name": "keyshow",
  "productName": "KeyShow",
  "version": "1.0.0",
  "description": "Keystroke and mouse overlay for tutorial videos",
  "main": "src/main.js",
  "author": "Agrysif",
  "license": "MIT",
  "private": true,
  "repository": "github:Agrysif/keyshow",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "build:dir": "electron-builder --win dir",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.keyshow.app",
    "productName": "KeyShow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "KeyShow-Setup-${version}.${ext}",
      "shortcutName": "KeyShow",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Agrysif",
        "repo": "keyshow",
        "releaseType": "release"
      }
    ]
  }
}
